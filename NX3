-- ESP + TRACERS
-- ============================================================
do
    local LocalPlayer = Players.LocalPlayer
    local Camera = workspace.CurrentCamera

    local function applyChams(char, color)
        if not char then return end
        local existing = char:FindFirstChild("ChamsESP")
        if existing then
            existing.FillColor = color
            existing.OutlineColor = color
            return
        end
        local h = Instance.new("Highlight")
        h.Name = "ChamsESP"
        h.FillTransparency = 0.75
        h.OutlineTransparency = 0.25
        h.FillColor = color
        h.OutlineColor = color
        h.Parent = char
    end

    local function refreshESP()
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Character then
                local e = plr.Character:FindFirstChild("ChamsESP")
                if e then e:Destroy() end
            end
        end
        if not settings.ESPEnabled then return end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local role = getPlayerRole(plr)
                local color = nil
                if role == "Murderer" and settings.MurderESP then
                    color = ROLE_COLORS.murderer
                elseif role == "Sheriff" and settings.SheriffESP then
                    color = ROLE_COLORS.sheriff
                elseif role == "Innocent" and settings.InnocentESP then
                    color = ROLE_COLORS.innocent
                end
                if color then applyChams(plr.Character, color) end
            end
        end
    end

    local nameTagObjects = {}
    local function destroyNameTag(plr)
        local t = nameTagObjects[plr]
        if t then
            if t.gui then pcall(function() t.gui:Destroy() end) end
            nameTagObjects[plr] = nil
        end
    end

    local function refreshNameTags()
        if not settings.NameTagESP then
            for plr in pairs(nameTagObjects) do destroyNameTag(plr) end
            return
        end
        for plr, tag in pairs(nameTagObjects) do
            if not plr.Parent or not plr.Character then destroyNameTag(plr) end
        end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local head = plr.Character:FindFirstChild("Head")
                if head then
                    local tag = nameTagObjects[plr]
                    if not tag then
                        local gui = Instance.new("BillboardGui")
                        gui.Name = "N3X_NameTag"
                        gui.Size = UDim2.new(0, 200, 0, 30)
                        gui.StudsOffset = Vector3.new(0, 2.5, 0)
                        gui.AlwaysOnTop = true
                        gui.MaxDistance = 500
                        gui.Parent = Camera
                        local tl = Instance.new("TextLabel")
                        tl.Size = UDim2.new(1, 0, 1, 0)
                        tl.BackgroundTransparency = 1
                        tl.Font = Enum.Font.GothamBold
                        tl.TextSize = 14
                        tl.TextStrokeTransparency = 0.3
                        tl.Parent = gui
                        tag = { gui = gui, label = tl }
                        nameTagObjects[plr] = tag
                    end
                    tag.gui.Adornee = head
                    tag.label.Text = plr.DisplayName
                end
            end
        end
    end

    local GUN_NAMES = {
        gundrop = true, gun = true, pistol = true, revolver = true,
        shotgun = true, firearm = true, weapon = true,
    }
    local gunESPObjects = {}
    local _gunCacheTime = 0
    local _gunCachedParts = {}

    local function _scanForGuns()
        local now = tick()
        if now - _gunCacheTime < 1.0 then return _gunCachedParts end
        _gunCacheTime = now
        _gunCachedParts = {}
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") and GUN_NAMES[v.Name:lower()] then
                table.insert(_gunCachedParts, v)
            end
        end
        return _gunCachedParts
    end

    local function refreshGunESP()
        for _, o in pairs(gunESPObjects) do pcall(function() o:Destroy() end) end
        gunESPObjects = {}
        if not settings.GunESP then return end
