    local function plUpdateOrder()
        local pinList, unpinList = {}, {}
        for p, _ in pairs(plRows) do
            if plPinned[p] then table.insert(pinList, p)
            else table.insert(unpinList, p) end
        end
        table.sort(pinList,   function(a, b) return a.UserId < b.UserId end)
        table.sort(unpinList, function(a, b) return a.UserId < b.UserId end)
        local order = 0
        for _, p in ipairs(pinList)   do order += 1; plRows[p].LayoutOrder = order end
        for _, p in ipairs(unpinList) do order += 1; plRows[p].LayoutOrder = order end
    end

    local function plSetPinnedVisual(row, isPinned)
        local pinBtn = row:FindFirstChild("PinButton")
        local target = isPinned and PL_THEME.RowBGPinned or PL_THEME.RowBG
        TweenService:Create(row, TweenInfo.new(0.15), { BackgroundColor3 = target }):Play()
        if pinBtn then
            pinBtn.TextColor3 = isPinned and PL_THEME.PinOn or PL_THEME.PinOff
        end
    end

    local function plTogglePin(p)
        plPinned[p] = plPinned[p] and nil or true
        local row = plRows[p]
        if row then plSetPinnedVisual(row, plPinned[p] == true) end
        plUpdateOrder()
    end

    local function plTeleportTo(p)
        if not p or p == player then return end
        local tChar = p.Character
        local tHRP  = tChar and tChar:FindFirstChild("HumanoidRootPart")
        if not tHRP then
            notify("[TP] " .. p.Name .. " has no character")
            return
        end
        local myChar = player.Character
        local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myHRP then
            notify("[TP] Your character isn't ready")
            return
        end
        local offset = tHRP.CFrame.RightVector * 3
        myHRP.CFrame = CFrame.new(tHRP.Position + offset)
        myHRP.AssemblyLinearVelocity  = Vector3.zero
        myHRP.AssemblyAngularVelocity = Vector3.zero
        notify("[TP] Teleported to " .. p.Name)
    end

