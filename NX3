local function _toolNames(plr)
    local names = {}
    if not plr then return names end
    local containers = {}
    if plr.Character then table.insert(containers, plr.Character) end
    local bp = plr:FindFirstChild("Backpack")
    if bp then table.insert(containers, bp) end
    for _, c in ipairs(containers) do
        for _, t in ipairs(c:GetChildren()) do
            if t:IsA("Tool") then names[#names + 1] = t.Name:lower() end
        end
    end
    return names
end

local function hasKnife(plr)
    for _, n in ipairs(_toolNames(plr)) do
        if n:find("knife") then return true end
    end
    return false
end

local function hasGun(plr)
    for _, n in ipairs(_toolNames(plr)) do
        if n:find("gun") or n:find("pistol") or n:find("revolver")
            or n:find("shotgun") or n:find("firearm") or n:find("weapon") then
            return true
        end
    end
    return false
end

local function getPlayerRole(plr)
    if not plr then return "Innocent" end
    if hasKnife(plr) then return "Murderer" end
    if hasGun(plr)   then return "Sheriff" end
    if _G.N3X_Roles[plr] then return _G.N3X_Roles[plr] end
    return "Innocent"
end

