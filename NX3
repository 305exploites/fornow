    trackF.Parent = holder
    trackF.AnchorPoint = Vector2.new(0, 0.5)
    trackF.Position = UDim2.new(0, x, 0.5, 0)
    trackF.Size = UDim2.new(0, SWITCH_W, 0, SWITCH_H)
    trackF.BackgroundColor3 = default and ON_C or OFF_C
    trackF.BorderSizePixel = 0
    trackF.ZIndex = 5
    corner(trackF, 1000)

    local knob = Instance.new("Frame")
    knob.Parent = trackF
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.BackgroundColor3 = Color3.fromRGB(255, 240, 245)
    knob.BorderSizePixel = 0
    knob.Size = UDim2.new(0, 14, 0, 14)
    knob.Position = default and UDim2.new(1, -10, 0.5, 0) or UDim2.new(0, 10, 0.5, 0)
    knob.ZIndex = 6
    corner(knob, 1000)

    local click = Instance.new("TextButton")
    click.Parent = trackF
    click.BackgroundTransparency = 1
    click.Text = ""
    click.Size = UDim2.new(1, 0, 1, 0)
    click.AutoButtonColor = false
    click.ZIndex = 7

    local state = default and true or false
    local function setState(newState, fireCallback)
        state = newState == true
        TweenService:Create(knob, TweenInfo.new(0.15), {
            Position = state and UDim2.new(1, -10, 0.5, 0) or UDim2.new(0, 10, 0.5, 0)
        }):Play()
        TweenService:Create(trackF, TweenInfo.new(0.15), {
            BackgroundColor3 = state and ON_C or OFF_C
        }):Play()
        if fireCallback and callback then task.spawn(callback, state) end
    end

    click.MouseButton1Click:Connect(function()
        setState(not state, true)
    end)

    return setState
end

local function Toggle(parent, label, default, callback)
    local holder = makeRow(parent, 22)
    makeLabel(holder, label)
    local setter = makeSwitch(holder, LABEL_W + GAP, default, callback)
    return holder, setter
end

local SLIDER_X = LABEL_W + GAP + SWITCH_W + 10
local SLIDER_W = 130

local function Slider(parent, label, default, min, max, onChange, onToggle)
    min = min or 0
    max = max or 100
    local pct = math.clamp((default - min) / (max - min), 0, 1)

    local holder = makeRow(parent, 22)
    local lbl = makeLabel(holder, label .. ": " .. default)
    makeSwitch(holder, LABEL_W + GAP, false, onToggle)

    local trackF = Instance.new("Frame")
    trackF.Parent = holder
    trackF.AnchorPoint = Vector2.new(0, 0.5)
    trackF.BackgroundColor3 = Color3.fromRGB(45, 15, 20)
    trackF.BorderSizePixel = 0
    trackF.Position = UDim2.new(0, SLIDER_X, 0.5, 0)
    trackF.Size = UDim2.new(0, SLIDER_W, 0, 4)
    trackF.ZIndex = 5
    corner(trackF, 1000)

    local fill = Instance.new("Frame")
    fill.Parent = trackF
    fill.BackgroundColor3 = PINK
    fill.BorderSizePixel = 0
    fill.Size = UDim2.new(pct, 0, 1, 0)
    fill.ZIndex = 6
    corner(fill, 1000)

    local knob = Instance.new("Frame")
    knob.Parent = trackF
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.BackgroundColor3 = Color3.fromRGB(255, 240, 245)
    knob.BorderSizePixel = 0
    knob.Position = UDim2.new(pct, 0, 0.5, 0)
    knob.Size = UDim2.new(0, 10, 0, 10)
    knob.ZIndex = 7
    corner(knob, 1000)
    local ks = Instance.new("UIStroke")
    ks.Thickness = 1.5
    ks.Color = PINK
    ks.Parent = knob

    local hit = Instance.new("TextButton")
    hit.Parent = holder
    hit.BackgroundTransparency = 1
    hit.Text = ""
    hit.AutoButtonColor = false
    hit.Position = UDim2.new(0, SLIDER_X - 5, 0, 0)
    hit.Size = UDim2.new(0, SLIDER_W + 10, 1, 0)
    hit.ZIndex = 8

    local dragging = false
    local lastValue = default
    local function update(x)
        local rel = math.clamp((x - trackF.AbsolutePosition.X) / trackF.AbsoluteSize.X, 0, 1)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, 0, 0.5, 0)
        local v = math.floor(min + (max - min) * rel + 0.5)
        lbl.Text = label .. ": " .. v
        if v ~= lastValue then
            lastValue = v
            if onChange then task.spawn(onChange, v) end
        end
    end

    hit.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(i.Position.X)
        end
    end)
    keep(UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            update(i.Position.X)
        end
    end))
    keep(UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
end

