    toast.BorderSizePixel = 0
    toast.Font = FONT
    toast.Text = msg
    toast.TextColor3 = TEXT
    toast.TextSize = 14
    toast.ZIndex = 100
    corner(toast, 8)
    local s = Instance.new("UIStroke")
    s.Color = PINK; s.Thickness = 1; s.Transparency = 0.4; s.Parent = toast
    TweenService:Create(toast, TweenInfo.new(0.15), { BackgroundTransparency = 0 }):Play()
    task.delay(3, function()
