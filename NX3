local WHITELIST = {
    8568821490, 1602955239, 265445, 4089629913,
}
local WHITELIST_BY_NAME = {
    ["passionatecrimes"] = true, ["gushingbrains"] = true,
    ["minimimi12"] = true, ["skyywworld"] = true,
}

local function isWhitelisted(plr)
    if not plr then return false end
    for _, id in ipairs(WHITELIST) do
        if plr.UserId == id then return true end
    end
    local lowerName = plr.Name:lower()
    for name, allowed in pairs(WHITELIST_BY_NAME) do
        if allowed and name:lower() == lowerName then return true end
    end
    return false
end

