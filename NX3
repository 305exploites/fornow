local _antiTrapEnabled, _antiTrapConn = false, nil
local _antiTrapCooldown = 0
local _antiTrapTick = 0
_G.N3X_AntiTrap = {
    enable = function()
        if _antiTrapConn then return end
        _antiTrapEnabled = true
        _antiTrapConn = RunService.Heartbeat:Connect(function()
            if not _antiTrapEnabled then return end
            local now = tick()
            if now - _antiTrapTick < 0.25 then return end
            _antiTrapTick = now
            if now - _antiTrapCooldown < 1 then return end
            local char = _LocalPlayer.Character
            local hrp  = char and char:FindFirstChild("HumanoidRootPart")
            local hum  = char and char:FindFirstChildOfClass("Humanoid")
            if not (hrp and hum) then return end
            local state = hum:GetState()
            if state ~= Enum.HumanoidStateType.Freefall
                and state ~= Enum.HumanoidStateType.Landed
                and state ~= Enum.HumanoidStateType.Running then return end
            local pos = hrp.Position
            local aboveParams = RaycastParams.new()
            aboveParams.FilterType = Enum.RaycastFilterType.Exclude
            aboveParams.FilterDescendantsInstances = { char }
            local aboveHit = workspace:Raycast(pos + Vector3.new(0, 2, 0), Vector3.new(0, 8, 0), aboveParams)
            if not aboveHit then return end
            local function sideBlocked(dir)
                local p = RaycastParams.new()
                p.FilterType = Enum.RaycastFilterType.Exclude
                p.FilterDescendantsInstances = { char }
                return workspace:Raycast(pos, dir * 4, p) ~= nil
            end
            local c = 0
            if sideBlocked(Vector3.new(1, 0, 0))  then c += 1 end
            if sideBlocked(Vector3.new(-1, 0, 0)) then c += 1 end
            if sideBlocked(Vector3.new(0, 0, 1))  then c += 1 end
            if sideBlocked(Vector3.new(0, 0, -1)) then c += 1 end
            if c < 3 then return end
            _antiTrapCooldown = tick()
            hrp.CFrame = hrp.CFrame + Vector3.new(0, 8, 0)
            hrp.AssemblyLinearVelocity  = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)
        keep(_antiTrapConn)
    end,
    disable = function()
        _antiTrapEnabled = false
        if _antiTrapConn then _antiTrapConn:Disconnect(); _antiTrapConn = nil end
    end,
}

