local _antiFlingEnabled, _antiFlingConn = false, nil
local _antiFlingLastCF = nil
local FLING_VEL = 250
local FLING_SPIN = 150
local _antiFlingLastTrigger = 0
local function _antiFlingSnap(hrp, hum)
    if _antiFlingLastCF then hrp.CFrame = _antiFlingLastCF end
    hrp.AssemblyLinearVelocity  = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    hrp.Velocity    = Vector3.zero
    hrp.RotVelocity = Vector3.zero
    if hum then pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end) end
end
_G.N3X_AntiFling = {
    enable = function()
        if _antiFlingConn then return end
        _antiFlingEnabled = true
        _antiFlingConn = RunService.Heartbeat:Connect(function()
            if not _antiFlingEnabled then return end
            local char = _LocalPlayer.Character
            local hrp  = char and char:FindFirstChild("HumanoidRootPart")
            local hum  = char and char:FindFirstChildOfClass("Humanoid")
            if not (hrp and hum) then return end
            local v    = hrp.AssemblyLinearVelocity
            local spin = hrp.AssemblyAngularVelocity
            if v.Magnitude < 80 and spin.Magnitude < 30 then
                _antiFlingLastCF = hrp.CFrame
                return
            end
            if v.Magnitude > FLING_VEL or spin.Magnitude > FLING_SPIN then
                local now = tick()
                if now - _antiFlingLastTrigger >= 0.35 then
                    _antiFlingLastTrigger = now
                    _antiFlingSnap(hrp, hum)
                    notify("[Anti-Fling] Blocked a fling attempt")
                else
                    _antiFlingSnap(hrp, hum)
                end
            end
        end)
        keep(_antiFlingConn)
    end,
    disable = function()
        _antiFlingEnabled = false
        if _antiFlingConn then _antiFlingConn:Disconnect(); _antiFlingConn = nil end
        _antiFlingLastCF = nil
    end,
}

