local function selectTab(page)
    for _, t in ipairs(tabs) do
        local active = (t.page == page)
        t.page.Visible = active
        t.btn:SetAttribute("Active", active)
        TweenService:Create(t.btn,    TWEEN, { BackgroundTransparency = active and TAB_TRANSPARENCY_ACTIVE or TAB_TRANSPARENCY_INACTIVE }):Play()
        TweenService:Create(t.stroke, TWEEN, { Transparency = active and 0.1 or 0.65 }):Play()
        TweenService:Create(t.dot,    TWEEN, { BackgroundTransparency = active and 0 or 0.7 }):Play()
        TweenService:Create(t.label,  TWEEN, { TextTransparency = active and 0 or 0.25 }):Play()
    end
end

