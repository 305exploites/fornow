-- ROLE TRACERS
-- ============================================================
do
    local Camera = workspace.CurrentCamera
    local HAS_DRAWING = (typeof(Drawing) == "table" and Drawing.new ~= nil)
    local RoleConfig = {
        Innocent = { color = Color3.fromRGB(255, 255, 255), width = 1,   transparency = 0.5 },
        Sheriff  = { color = Color3.fromRGB(60, 130, 255),  width = 1,   transparency = 0.5 },
        Murderer = { color = Color3.fromRGB(255, 40, 40),   width = 1.5, transparency = 0.3 },
    }
    local tracerOrigin = "Bottom"

    local drawingLines = {}
    local function createDrawingLine(plr)
        if not HAS_DRAWING then return nil end
        if drawingLines[plr] then return drawingLines[plr] end
        local line = Drawing.new("Line")
        line.Visible = false
        line.Thickness = 1
        line.Transparency = 0.5
        line.Color = Color3.new(1, 1, 1)
        line.From = Vector2.new(0, 0)
        line.To = Vector2.new(0, 0)
        drawingLines[plr] = line
        return line
    end

    local function destroyDrawingLine(plr)
        local line = drawingLines[plr]
        if line then pcall(function() line:Remove() end); drawingLines[plr] = nil end
    end

    local function normalizeRole(role)
        if type(role) ~= "string" then return nil end
        local lower = role:lower()
        if lower:find("murder") then return "Murderer" end
        if lower:find("sheriff") then return "Sheriff" end
        if lower:find("innocent") then return "Innocent" end
        return nil
    end
    local function getRoleOf(plr)
        return normalizeRole(getPlayerRole(plr))
    end

    local function getOriginVec()
        local cam = workspace.CurrentCamera
        if not cam then return Vector2.new(0, 0) end
        if tracerOrigin == "Mouse" then
            local m = UserInputService:GetMouseLocation()
            return Vector2.new(m.X, m.Y)
        elseif tracerOrigin == "Center" then
            return Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
        else
            return Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
        end
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= Players.LocalPlayer and HAS_DRAWING then
            createDrawingLine(plr)
        end
    end
    keep(Players.PlayerAdded:Connect(function(plr)
        if plr ~= Players.LocalPlayer and HAS_DRAWING then
            createDrawingLine(plr)
        end
    end))
    keep(Players.PlayerRemoving:Connect(function(plr)
        if HAS_DRAWING then destroyDrawingLine(plr) end
    end))

    keep(RunService.RenderStepped:Connect(function()
        local cam = workspace.CurrentCamera
        if not cam then return end
        local enabledByRole = {
            Innocent = settings.InnocentTracer == true,
            Sheriff  = settings.SheriffTracer  == true,
            Murderer = settings.MurdererTracer == true,
        }
        local anyOn = enabledByRole.Innocent or enabledByRole.Sheriff or enabledByRole.Murderer
        if not anyOn then
            for _, l in pairs(drawingLines) do l.Visible = false end
            return
        end

        if HAS_DRAWING then
            local fromPos = getOriginVec()
            for plr, line in pairs(drawingLines) do
                if not plr or not plr.Parent then
                    pcall(function() line:Remove() end)
                    drawingLines[plr] = nil
                else
                    local role = getRoleOf(plr)
                    local cfg = role and RoleConfig[role]
                    if cfg and enabledByRole[role] then
                        local char = plr.Character
                        local hrp = char and char:FindFirstChild("HumanoidRootPart")
                        local hum = char and char:FindFirstChildOfClass("Humanoid")
                        if hrp and hum and hum.Health > 0 then
                            local aimPos = hrp.Position - Vector3.new(0, hrp.Size.Y, 0)
                            local screenPos, onScreen = cam:WorldToViewportPoint(aimPos)
                            if onScreen then
                                line.From = fromPos
                                line.To = Vector2.new(screenPos.X, screenPos.Y)
                                line.Color = cfg.color
                                line.Thickness = cfg.width
                                line.Transparency = cfg.transparency
                                line.Visible = true
                            else
                                line.Visible = false
                            end
                        else
                            line.Visible = false
                        end
                    else
                        line.Visible = false
                    end
                end
            end
        end
    end))
end

