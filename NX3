local _flyConn, _flyVelo, _flyGyro = nil, nil, nil
local _flyEnabled, _flySpeed = false, 50
_G.N3X_Fly = {
    setEnabled = function(on)
        if on and not _flyEnabled then
            local char = _LocalPlayer.Character
            local hrp  = char and char:FindFirstChild("HumanoidRootPart")
            local hum  = char and char:FindFirstChildOfClass("Humanoid")
            if not (hrp and hum) then return end
            _flyEnabled = true
            hum.PlatformStand = true
            _flyVelo = Instance.new("BodyVelocity")
            _flyVelo.MaxForce = Vector3.new(1e5, 1e5, 1e5)
            _flyVelo.Velocity = Vector3.zero
            _flyVelo.Parent = hrp
            _flyGyro = Instance.new("BodyGyro")
            _flyGyro.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
            _flyGyro.P = 1e3
            _flyGyro.CFrame = hrp.CFrame
            _flyGyro.Parent = hrp
            _flyConn = RunService.RenderStepped:Connect(function()
                if not _flyEnabled then return end
                local c = _LocalPlayer.Character
                local r = c and c:FindFirstChild("HumanoidRootPart")
                if not r then _flyEnabled = false; return end
                local cam = workspace.CurrentCamera
                local move = Vector3.zero
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then move += cam.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then move -= cam.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then move -= cam.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then move += cam.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move += Vector3.new(0, 1, 0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then move -= Vector3.new(0, 1, 0) end
                if move.Magnitude > 0 then move = move.Unit end
                _flyVelo.Velocity = move * _flySpeed
                _flyGyro.CFrame = cam.CFrame
            end)
            keep(_flyConn)
        else
            _flyEnabled = false
            if _flyConn then _flyConn:Disconnect(); _flyConn = nil end
            local char = _LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then hum.PlatformStand = false end
            if _flyVelo then pcall(function() _flyVelo:Destroy() end); _flyVelo = nil end
            if _flyGyro then pcall(function() _flyGyro:Destroy() end); _flyGyro = nil end
        end
    end,
    setSpeed = function(v) _flySpeed = math.clamp(v, 10, 500) end,
}

